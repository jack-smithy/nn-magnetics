                        "torch.Size([10, 4]) torch.Size([10, 3])\n",
                        "torch.Size([10, 4]) torch.Size([10, 3])\n",
                        "torch.Size([10, 4]) torch.Size([10, 3])\n"
                    ]
                }
            ],
            "source": [
                "for xi, bi in zip(*loader):\n",
                "    print(xi.shape, bi.shape)"
            ]
